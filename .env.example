# --- Backend ---
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Elige UNA segun Supabase -> Project Settings -> JWT Keys (JWT Signing Keys):
#  - Claves asimetricas (ES256/RS256, proyectos nuevos): define SUPABASE_JWKS_URL y deja SUPABASE_JWT_SECRET vacio.
#    SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
#  - Secreto heredado (HS256): define SUPABASE_JWT_SECRET.
# Si eliges mal, TODAS las peticiones devuelven 401 (mira el 'alg' del token en jwt.io y el log del backend).
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text
SIMILARITY_THRESHOLD=0.55
TOP_K=5
MAX_UPLOAD_MB=10
CORS_ORIGINS=http://localhost:5173
# --- Frontend (frontend/.env) ---
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
